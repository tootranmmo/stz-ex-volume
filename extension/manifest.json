{
  "manifest_version": 3,
  "name": "STZ Ex Volume Checker",
  "version": "1.0.0",
  "description": "Tự động kiểm tra search volume từ khóa trên searchvolume.com",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://searchvolume.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "STZ Ex Volume Checker"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://searchvolume.com/*"],
      "js": ["src/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "src/icons/icon-16.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  }
}
